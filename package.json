{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "predev": "yarn lint",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6007",
    "test": "vitest run --project=storybook",
    "test:visual": "sh .storybook/visual.sh",
    "clean-install": "rm -rf ./node_modules && rm -rf ./.nuxt && rm -rf ./dist && rm -rf .output && yarn install --network-concurrency 1"
  },
  "ts-standard": {
    "ignore": [
      ".nuxt",
      "dist",
      "node_modules",
      ".output"
    ],
    "project": "./tsconfig.eslint.json"
  },
  "dependencies": {
    "@nuxt/image": "2.2.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/robots": "5.4.0",
    "@pinia/nuxt": "0.11.2",
    "@popperjs/core": "^2.11.8",
    "@scbd/vue-components": "git+https://github.com/scbd/vue-components.git",
    "@types/bootstrap": "^5.2.10",
    "@types/jsonapi-serializer": "^3.6.8",
    "api-client": "git+https://github.com/scbd/api-client.git",
    "bootstrap": "5.3.7",
    "isomorphic-dompurify": "^2.30.1",
    "jsdom": "^28.1.0",
    "jsonapi-serializer": "^3.6.9",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.23",
    "nuxt": "^4.6.4",
    "nuxt-gtag": "3.0.3",
    "pinia": "^3.0.3",
    "sass": "^1.90.0",
    "vue": "^3.5.44",
    "vue-dompurify-html": "^5.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook-vue/nuxt": "^10.0.3",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.9.2",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "fs-extra": "^11.3.2",
    "playwright": "1.65.0",
    "storybook": "^10.6.7",
    "ts-standard": "^12.0.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.3"
  }
}
